# Azure AD Configuration
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Redirect URIs
VITE_REDIRECT_URI=http://localhost:3001
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:3001

# API Configuration
VITE_API_BASE_URL=http://localhost:3002/api

# Application Configuration
VITE_APP_NAME="Entra Management App"
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_INTEGRATIONS=true

# Polling Intervals (in milliseconds)
VITE_DASHBOARD_REFRESH_INTERVAL=30000
VITE_COMPLIANCE_CHECK_INTERVAL=60000

# UI Configuration
VITE_ITEMS_PER_PAGE=25
VITE_MAX_UPLOAD_SIZE=10485760

# External Services (Optional)
VITE_MICROSOFT_DOCS_BASE_URL=https://docs.microsoft.com
VITE_SUPPORT_EMAIL=support@yourcompany.com
VITE_FEEDBACK_URL=https://feedback.yourcompany.com