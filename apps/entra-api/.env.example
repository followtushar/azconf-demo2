# Azure/Entra ID Configuration
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id
AZURE_REDIRECT_URI=http://localhost:3002/auth/callback

# Microsoft Graph API
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
GRAPH_SCOPES=https://graph.microsoft.com/.default

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/entra_management
REDIS_URL=redis://localhost:6379

# Application Configuration
PORT=3002
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key
API_BASE_URL=http://localhost:3002

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Compliance Framework Configuration
FRAMEWORKS_CONFIG_PATH=./config/frameworks.json
CONTROLS_MAPPING_PATH=./config/controls-mapping.json