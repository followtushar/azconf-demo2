# Database Configuration
DATABASE_URL="postgresql://timecap:password@localhost:5432/timecap"
DATABASE_URL_TEST="postgresql://timecap:password@localhost:5432/timecap_test"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"

# API Configuration
API_PORT=8000
API_URL="http://localhost:8000"
WEB_URL="http://localhost:3000"

# File Storage Configuration
STORAGE_PROVIDER="azure" # local, azure, aws, gcp
STORAGE_PATH="./uploads"

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="timecap-media"
AZURE_STORAGE_SAS_TOKEN=""

# Azure Blob Storage CDN (optional)
AZURE_CDN_ENDPOINT=""

# Email Configuration (Azure Communication Services)
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_EMAIL_ENDPOINT=""
FROM_EMAIL="noreply@timecap.app"
FROM_NAME="TimeCap"

# SMS Configuration (Azure Communication Services)
AZURE_COMMUNICATION_SMS_CONNECTION_STRING=""
AZURE_COMMUNICATION_PHONE_NUMBER=""

# Push Notifications (Azure Notification Hubs)
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=""
AZURE_NOTIFICATION_HUB_NAME=""

# OAuth Configuration
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=100 # MB
MAX_VIDEO_DURATION=600 # seconds (10 minutes)
MAX_AUDIO_DURATION=1800 # seconds (30 minutes)

# Scheduling
SCHEDULER_CHECK_INTERVAL=60000 # 1 minute in milliseconds
MAX_FUTURE_DATE_YEARS=50

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret"
CORS_ORIGIN="http://localhost:3000"

# Azure Key Vault (for production secrets)
AZURE_KEY_VAULT_URL=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# Azure Application Insights
AZURE_APPLICATION_INSIGHTS_CONNECTION_STRING=""
AZURE_APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=""

# Azure Service Bus (for job queue)
AZURE_SERVICE_BUS_CONNECTION_STRING=""
AZURE_SERVICE_BUS_QUEUE_NAME="timecap-jobs"

# Azure Database for PostgreSQL
AZURE_POSTGRES_HOST=""
AZURE_POSTGRES_USER=""
AZURE_POSTGRES_PASSWORD=""
AZURE_POSTGRES_DATABASE="timecap"
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_SSL_MODE="require"

# Azure Cache for Redis
AZURE_REDIS_HOST=""
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=""
AZURE_REDIS_SSL=true

# Monitoring & Logging
LOG_LEVEL="info" # error, warn, info, debug
AZURE_LOG_ANALYTICS_WORKSPACE_ID=""
AZURE_LOG_ANALYTICS_SHARED_KEY=""

# Development
NODE_ENV="development"
DEBUG="timecap:*"