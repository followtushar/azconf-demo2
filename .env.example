# Database Configuration
DATABASE_URL="postgresql://timecap:password@localhost:5432/timecap"
DATABASE_URL_TEST="postgresql://timecap:password@localhost:5432/timecap_test"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"

# API Configuration
API_PORT=8000
API_URL="http://localhost:8000"
WEB_URL="http://localhost:3000"

# File Storage Configuration
STORAGE_PROVIDER="local" # local, aws, azure, gcp
STORAGE_PATH="./uploads"

# AWS S3 Configuration (if using AWS)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="timecap-media"

# Azure Blob Storage (if using Azure)
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_STORAGE_CONTAINER="timecap-media"

# Email Configuration (SendGrid)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@timecap.app"
FROM_NAME="TimeCap"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# OAuth Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=100 # MB
MAX_VIDEO_DURATION=600 # seconds (10 minutes)
MAX_AUDIO_DURATION=1800 # seconds (30 minutes)

# Scheduling
SCHEDULER_CHECK_INTERVAL=60000 # 1 minute in milliseconds
MAX_FUTURE_DATE_YEARS=50

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret"
CORS_ORIGIN="http://localhost:3000"

# Monitoring & Logging
LOG_LEVEL="info" # error, warn, info, debug
SENTRY_DSN=""

# Development
NODE_ENV="development"
DEBUG="timecap:*"