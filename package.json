{
  "name": "timecap",
  "version": "1.0.0",
  "description": "A time capsule app for scheduling future message delivery",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run db:setup",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:queue\" \"npm run dev:entra-api\" \"npm run dev:entra-web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:queue": "npm run dev --workspace=apps/queue-worker",
    "dev:entra-api": "npm run dev --workspace=apps/entra-api",
    "dev:entra-web": "npm run dev --workspace=apps/entra-management",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:e2e": "npm run test:e2e --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "db:setup": "npm run db:setup --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "clean": "npm run clean --workspaces && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "time-capsule",
    "scheduling",
    "messages",
    "audio",
    "video",
    "future-delivery"
  ],
  "author": "TimeCap Team",
  "license": "MIT"
}